        given-names: "My Dung"
    title: "Mathematical modelling of synergistic triple-antibiotic therapy against carbapenem-resistant Acinetobacter baumannii at clinically achievable concentrations"
    journal: "Journal of Medical Microbiology"
    year: 2025
    volume: 74
    doi: "10.1099/jmm.0.002086"
